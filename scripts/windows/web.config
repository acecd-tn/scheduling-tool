<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy for PSAP Scheduler (HTTPS at IIS, app on http://127.0.0.1:8080).
  Requires the IIS "URL Rewrite" and "Application Request Routing" (ARR) modules,
  with proxy enabled (IIS Manager > server node > Application Request Routing Cache >
  Server Proxy Settings > Enable proxy). Copy this file into the IIS site's folder
  (the folder can otherwise be empty). See docs/WINDOWS.md.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Send plain HTTP to HTTPS -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Everything else goes to the app -->
        <rule name="PSAP Scheduler" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Compression buffers responses and would delay live updates (/api/events). -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <!-- allow backup imports up to 50 MB -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
